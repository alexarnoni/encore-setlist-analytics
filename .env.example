# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed (see CLAUDE.md).

# --- setlist.fm API ---
# Free, non-commercial API key: https://api.setlist.fm/docs/1.0/index.html
SETLISTFM_API_KEY=

# --- PostgreSQL (shared instance for the `airflow` and `encore` databases) ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me
# Name of the database Airflow's own metadata lives in. The `encore`
# database (raw/staging/intermediate/analytics/ops schemas) is created
# alongside it by infra/postgres/init/01_create_encore_database.sh.
POSTGRES_DB=airflow

# --- Airflow ---
AIRFLOW_IMAGE_NAME=encore-airflow:3.3.2
# On Linux, set this to your host UID (`id -u`) so files Airflow writes
# into mounted volumes are owned by you, not root. Leave the default on
# Windows/macOS.
AIRFLOW_UID=50000
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_JWT_SECRET=
AIRFLOW_WWW_USER_USERNAME=airflow
AIRFLOW_WWW_USER_PASSWORD=change-me

# --- Advanced (optional, only for the VM deploy) ---
# infra/docker-compose.yml defaults AIRFLOW_PROJ_DIR to ".." (repo root)
# and ENV_FILE_PATH to "../.env". Override only if the compose file is
# invoked from a different working directory than infra/.
# AIRFLOW_PROJ_DIR=
# ENV_FILE_PATH=

# --- Ingestion ---
# Optional comma-separated list of band names (must match config/bands.yaml
# exactly) to limit a run to a subset of bands. Leave empty to process all
# 7 bands. Used for the first real run against production APIs (a single
# band) and for local smoke-testing.
ENCORE_BANDS_FILTER=
